# 复制本文件为 .env 后按需填写。
# .env 已在 .gitignore 中忽略，禁止提交真实密钥。

# ---------------- 大模型配置 ----------------
# Provider：qwen（代码通过 base_url 适配 OpenAI 兼容接口，无需单独配置 Provider）
LLM_MODEL=qwen4-max
LLM_API_KEY=
LLM_BASE_URL=https://llm-ly6g49klymb0kpyw.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# ---------------- Agent 配置 ----------------
AGENT_MAX_STEPS=8
# 工具文件操作与命令执行的活动目录（相对项目根目录或绝对路径）
AGENT_WORKSPACE_DIR=workspace
# 是否允许执行 shell 命令（安全边界由工具库实现）
AGENT_ALLOW_SHELL=false

# ---------------- 检索与选择配置 ----------------
RETRIEVAL_TOP_K=5
ADAPTIVE_MIN_K=3
ADAPTIVE_MAX_K=8

# ---------------- 实验配置 ----------------
DEFAULT_EXPERIMENT_MODE=baseline
